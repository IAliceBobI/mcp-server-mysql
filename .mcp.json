{
  "mcpServers": {
    "mysql-local": {
      "command": "node",
      "args": [
        "./dist/index.js"
      ],
      "env": {
        "MYSQL_HOST": "127.0.0.1",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "root",
        "MYSQL_PASS": "",
        "MYSQL_DB": "mcp_test",
        "TABLE_WRITE_WHITELIST": "mcp_test.whitelist_users,mcp_test.whitelist_orders,mcp_test.app_logs",
        "MYSQL_ENABLE_LOGGING": "true"
      }
    }
  }
}