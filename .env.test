# Basic MySQL connection settings
MYSQL_HOST=127.0.0.1
# MYSQL_SOCKET_PATH=/tmp/mysql.sock
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=
MYSQL_DB=mcp_test

# Table write whitelist (new granular permission system)
# Each operation type has its own whitelist
# Supports wildcards: *.logs, production.*, dev.test_*
# Format: JSON array string
TABLE_INSERT_WHITELIST=["mcp_test.whitelist_users", "mcp_test.whitelist_orders", "mcp_test.app_logs"]
TABLE_UPDATE_WHITELIST=["mcp_test.whitelist_users", "mcp_test.whitelist_orders", "mcp_test.app_logs"]
TABLE_DELETE_WHITELIST=["mcp_test.whitelist_users", "mcp_test.whitelist_orders", "mcp_test.app_logs"]
TABLE_DDL_CREATE_WHITELIST=["mcp_test.temp_*"]
TABLE_DDL_ALTER_WHITELIST=["mcp_test.whitelist_users"]
TABLE_DDL_DROP_WHITELIST=["mcp_test.temp_*"]
TABLE_DDL_TRUNCATE_WHITELIST=["mcp_test.whitelist_users", "mcp_test.whitelist_orders", "mcp_test.app_logs"]

# Multi-DB mode settings
# Set to true ONLY if you want to allow write operations in multi-DB mode without
# schema-specific permissions (not recommended)
MULTI_DB_WRITE_MODE=true

# SSL configuration
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Performance settings
MYSQL_POOL_SIZE=10
MYSQL_QUERY_TIMEOUT=30000
MYSQL_CACHE_TTL=60000

# Security settings
MYSQL_RATE_LIMIT=100
MYSQL_MAX_QUERY_COMPLEXITY=1000

# Monitoring settings
ENABLE_LOGGING=true
MYSQL_LOG_LEVEL=info
MYSQL_METRICS_ENABLED=false

# Test settings
TEST_TIMEOUT=10000
TEST_POOL_SIZE=5
